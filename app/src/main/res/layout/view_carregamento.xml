<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:elevation="24dp"
    android:clickable="true"
    android:focusable="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/loading_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/bettergym_logo" />

        <TextView
            android:id="@+id/txtEtapaCarregamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/loading_map"
            android:textColor="#475569"
            android:textSize="15sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barraCarregamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:indeterminate="false"
            android:max="100"
            app:indicatorColor="#93C83E"
            app:trackColor="#E8EEF1"
            app:trackCornerRadius="6dp"
            app:trackThickness="10dp" />

        <TextView
            android:id="@+id/txtPercentagemCarregamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/loading_initial_percent"
            android:textColor="#05243A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepetirCarregamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_retry"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarCarregamento"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_continue"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
