<resources>
    <style name="ThemeOverlay.BetterGym.PasswordDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/secondary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/primary</item>
        <item name="colorError">@color/estado_fechado</item>
        <item name="colorControlNormal">#64748B</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.BetterGym.PasswordDialog</item>
    </style>
    <style name="ShapeAppearanceOverlay.BetterGym.PasswordDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="Widget.BetterGym.PasswordInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#F7F9FB</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="endIconTint">@color/primary</item>
        <item name="helperTextTextColor">#64748B</item>
    </style>
</resources>
